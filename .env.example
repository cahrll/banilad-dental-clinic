# MongoDB Atlas connection string. The database name MUST be in the URL path
# (between the host and the `?` query string) — Prisma's MongoDB connector
# requires it. Example:
#
#   mongodb+srv://USER:PASSWORD@HOST.mongodb.net/banilad_dental?appName=BaniladDentalClinic
#
DATABASE_URL="mongodb+srv://USER:PASSWORD@HOST.mongodb.net/banilad_dental?appName=BaniladDentalClinic"
